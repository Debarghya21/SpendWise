# Copy to .env and change the values. NEVER commit the real .env file.

# Docker Hub namespace + version tag used for every image
DOCKER_NAMESPACE=spendwise
APP_VERSION=1.0.0

# Supplier Service - PostgreSQL
SUPPLIER_DB_NAME=supplier_db
SUPPLIER_DB_USER=supplier_user
SUPPLIER_DB_PASSWORD=supplier_pass

# Purchase Order Service - MySQL
PO_DB_NAME=purchase_order_db
PO_DB_USER=po_user
PO_DB_PASSWORD=po_pass
PO_DB_ROOT_PASSWORD=root_pass

# Budget Service - PostgreSQL
BUDGET_DB_NAME=budget_db
BUDGET_DB_USER=budget_user
BUDGET_DB_PASSWORD=budget_pass

# Spend Analytics Service - MongoDB
ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=analytics_pass

# RabbitMQ
RABBITMQ_USER=spendwise
RABBITMQ_PASSWORD=spendwise_pass
