# SpendWise API Gateway (NGINX)
# Rendered by the official nginx image entrypoint (envsubst) at container start.
# Upstreams are resolved at request time through ${NGINX_RESOLVER}, so the gateway
# keeps running even when one backend is stopped (needed for the circuit-breaker demo).

resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

log_format spendwise '$remote_addr [$time_local] "$request" $status '
                     'upstream=$upstream_addr rt=$request_time id=$request_id';

server {
    listen 8080;
    server_name _;
    access_log /var/log/nginx/access.log spendwise;

    client_max_body_size 2m;

    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 15s;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $request_id;
    add_header X-Request-Id $request_id always;

    set $supplier_upstream       ${SUPPLIER_UPSTREAM};
    set $purchase_order_upstream ${PURCHASE_ORDER_UPSTREAM};
    set $budget_upstream         ${BUDGET_UPSTREAM};
    set $analytics_upstream      ${ANALYTICS_UPSTREAM};

    # -------- Gateway health
    location = /health {
        default_type application/json;
        return 200 '{"status":"UP","service":"api-gateway"}';
    }

    # -------- Per-service health (used by System Monitoring page)
    location = /health/supplier       { proxy_pass http://$supplier_upstream/health; }
    location = /health/purchase-order { proxy_pass http://$purchase_order_upstream/health; }
    location = /health/budget         { proxy_pass http://$budget_upstream/health; }
    location = /health/analytics      { proxy_pass http://$analytics_upstream/health; }

    # -------- API routes (path prefix preserved)
    location /api/suppliers       { proxy_pass http://$supplier_upstream; }
    location /api/purchase-orders { proxy_pass http://$purchase_order_upstream; }
    location /api/budgets         { proxy_pass http://$budget_upstream; }
    location /api/reservations    { proxy_pass http://$budget_upstream; }
    location /api/analytics       { proxy_pass http://$analytics_upstream; }

    # -------- Uniform JSON error when a backend is down
    proxy_intercept_errors on;
    error_page 502 503 504 = @unavailable;
    location @unavailable {
        default_type application/json;
        return 503 '{"error":"SERVICE_UNAVAILABLE","message":"Upstream service is unavailable","requestId":"$request_id"}';
    }

    location / {
        default_type application/json;
        return 404 '{"error":"NOT_FOUND","message":"No route for $uri"}';
    }
}
